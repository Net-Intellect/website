---
// Any link to a Microsoft Form (forms.office.com, forms.microsoft.com or
// forms.cloud.microsoft) opens the form in a pop-up over the page instead of
// leaving the site. On phones, or without JavaScript, the link simply opens the
// form in a new tab.
---
<dialog class="form-popup" aria-label="Form">
  <!-- Close sits in its own strip so it never covers the form's own menu button. -->
  <div class="form-popup-bar">
    <button type="button" class="form-popup-close" aria-label="Close">×</button>
  </div>
  <iframe title="Form" loading="lazy"></iframe>
</dialog>

<style>
  .form-popup {
    width: min(760px, calc(100vw - 32px)); height: min(860px, calc(100vh - 48px));
    padding: 0; border: 0; border-radius: var(--radius); overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
  }
  .form-popup[open] { display: flex; flex-direction: column; }
  .form-popup::backdrop { background: rgba(44, 57, 62, .7); }
  .form-popup-bar { display: flex; justify-content: flex-end; padding: 6px 8px; background: var(--color-charcoal); }
  .form-popup iframe { flex: 1; width: 100%; border: 0; display: block; }
  .form-popup-close {
    width: 36px; height: 36px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .12); color: #fff;
    font-size: 24px; line-height: 1; cursor: pointer;
  }
  .form-popup-close:hover, .form-popup-close:focus-visible { background: var(--color-accent); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".form-popup");
  const frame = dialog?.querySelector("iframe");
  const links = document.querySelectorAll<HTMLAnchorElement>(
    'a[href*="forms.office.com"], a[href*="forms.microsoft.com"], a[href*="forms.cloud.microsoft"]',
  );
  for (const link of links) {
    link.target = "_blank";
    link.rel = "noopener";
    link.addEventListener("click", (event) => {
      if (!dialog || !frame || window.innerWidth < 640) return;
      event.preventDefault();
      const url = new URL(link.href);
      url.searchParams.set("embed", "true");
      if (frame.src !== url.href) frame.src = url.href;
      dialog.showModal();
    });
  }
  dialog?.querySelector(".form-popup-close")?.addEventListener("click", () => dialog.close());
  // Clicking the dimmed area outside the form closes it too.
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
