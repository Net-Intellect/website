---
// Net Intellect's own line-icon set, drawn on a 24px grid with one stroke
// weight so every card reads as part of the same family. Colour comes from
// `currentColor`; `.icon-tile` gives the soft blue square behind it.
interface Props {
  name: string;
  tile?: boolean;
  label?: string;
}
const { name, tile = true, label } = Astro.props;

// Service ids map onto the drawings below, so content files need no icon field.
const aliases: Record<string, string> = {
  "managed-it-support": "support",
  "cybersecurity-compliance": "shield",
  "microsoft-365-cloud-azure": "cloud",
  "ai-implementation-governance": "ai",
  "networking-mobile-computing": "network",
  "disaster-recovery-business-continuity": "recovery",
  "voice-voip": "voice",
  "broadband-services": "broadband",
  "supportnet-security": "supportnet",
};
const key = aliases[name] ?? name;
---
<span class:list={[{ "icon-tile": tile }, "icon"]} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {key === "support" && (<>
      <rect x="3" y="4" width="18" height="12" rx="1.5" />
      <path d="M12 16v4M8 20h8" />
      <path d="M6 10.5h3l1.5-3 2.5 5.5 1.5-3H18" />
    </>)}
    {key === "shield" && (<>
      <path d="M12 2.5l7.5 2.5v6c0 5-3.3 8.8-7.5 10.5C7.8 19.8 4.5 16 4.5 11V5z" />
      <path d="M8.5 12l2.5 2.5 4.5-5" />
    </>)}
    {key === "cloud" && (<>
      <path d="M7.5 18.5h10a4 4 0 0 0 .4-7.98A5.5 5.5 0 0 0 7.3 9.1 4.7 4.7 0 0 0 7.5 18.5z" />
      <g fill="currentColor" stroke="none">
        <rect x="9.6" y="11.6" width="2.1" height="2.1" rx=".3" />
        <rect x="12.3" y="11.6" width="2.1" height="2.1" rx=".3" />
        <rect x="9.6" y="14.3" width="2.1" height="2.1" rx=".3" />
        <rect x="12.3" y="14.3" width="2.1" height="2.1" rx=".3" />
      </g>
    </>)}
    {key === "ai" && (<>
      <rect x="6.5" y="6.5" width="11" height="11" rx="1.5" />
      <path d="M9.5 3.5v3M12 3.5v3M14.5 3.5v3M9.5 17.5v3M12 17.5v3M14.5 17.5v3M3.5 9.5h3M3.5 12h3M3.5 14.5h3M17.5 9.5h3M17.5 12h3M17.5 14.5h3" />
      <path d="M12 8.9l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9z" fill="currentColor" stroke-width="1" />
    </>)}
    {key === "network" && (<>
      <circle cx="12" cy="5" r="2" />
      <circle cx="5" cy="19" r="2" />
      <circle cx="19" cy="19" r="2" />
      <circle cx="12" cy="12.5" r="1.4" fill="currentColor" />
      <path d="M12 7v4.1M10.9 13.4l-4.5 4.2M13.1 13.4l4.5 4.2" />
    </>)}
    {key === "recovery" && (<>
      <ellipse cx="10" cy="5.5" rx="7" ry="2.5" />
      <path d="M3 5.5v11c0 1.4 3.1 2.5 7 2.5M17 5.5v4.5M3 11c0 1.4 3.1 2.5 7 2.5" />
      <path d="M21 16.5a4.5 4.5 0 1 1-1.3-3.2" />
      <path d="M20.1 10.6l-.3 2.8-2.7-.3" />
    </>)}
    {key === "voice" && (<>
      <path d="M6.6 3.5h2.7l1.4 4-1.9 1.3a10 10 0 0 0 6.4 6.4l1.3-1.9 4 1.4v2.7a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" />
      <path d="M15 3.5a5.5 5.5 0 0 1 5.5 5.5M15 6.5a2.5 2.5 0 0 1 2.5 2.5" />
    </>)}
    {key === "broadband" && (<>
      <rect x="3" y="13" width="18" height="6.5" rx="1.5" />
      <path d="M17 13V9.5" />
      <path d="M14.2 7.3a4 4 0 0 1 5.6 0M12.3 5.2a6.7 6.7 0 0 1 9.4 0" />
      <g fill="currentColor" stroke="none"><circle cx="7" cy="16.25" r=".95" /><circle cx="10" cy="16.25" r=".95" /></g>
    </>)}
    {key === "supportnet" && (<>
      <path d="M12 2.5l7.5 2.5v6c0 5-3.3 8.8-7.5 10.5C7.8 19.8 4.5 16 4.5 11V5z" />
      <circle cx="12" cy="9.5" r="2" />
      <path d="M8.6 15.6a3.4 3.4 0 0 1 6.8 0" />
    </>)}
    {key === "aged-care" && (<>
      <path d="M3.5 11L12 4l8.5 7" />
      <path d="M6 9.2V20h12V9.2" />
      <path d="M12 17.6s-3.4-2-3.4-4.3a1.7 1.7 0 0 1 3.4-.6 1.7 1.7 0 0 1 3.4.6c0 2.3-3.4 4.3-3.4 4.3z" />
    </>)}
    {key === "community-health" && (<>
      <path d="M12 2.5v4.5M9.75 4.75h4.5" />
      <circle cx="7.5" cy="11" r="2" />
      <circle cx="16.5" cy="11" r="2" />
      <path d="M3.5 20a4 4 0 0 1 8 0M12.5 20a4 4 0 0 1 8 0" />
    </>)}
    {key === "ndis" && (<>
      <circle cx="12" cy="5.5" r="2.2" />
      <path d="M8.8 11.8a3.2 3.2 0 0 1 6.4 0" />
      <path d="M2.5 13.5c1.7-.3 3 .6 3.9 2l1 1.6c.6.9 1.6 1.5 2.7 1.5H12M2.5 13.5V20" />
      <path d="M21.5 13.5c-1.7-.3-3 .6-3.9 2l-1 1.6c-.6.9-1.6 1.5-2.7 1.5H12M21.5 13.5V20" />
    </>)}
    {key === "business" && (<>
      <path d="M4 9l1.6-4.5h12.8L20 9" />
      <path d="M4 9h16M5 9v11h14V9M3 20h18" />
      <path d="M10 20v-5h4v5" />
      <path d="M6.8 12h2M15.2 12h2" />
    </>)}
    {key === "history" && (<>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>)}
    {key === "values" && (<>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="4.8" />
      <circle cx="12" cy="12" r="1.3" fill="currentColor" />
    </>)}
    {key === "people" && (<>
      <circle cx="12" cy="8" r="2.6" />
      <circle cx="5.8" cy="10.2" r="2" />
      <circle cx="18.2" cy="10.2" r="2" />
      <path d="M7.5 19a4.5 4.5 0 0 1 9 0M2.5 18.5a3.5 3.5 0 0 1 4.6-3.3M21.5 18.5a3.5 3.5 0 0 0-4.6-3.3" />
    </>)}
    {key === "quote" && (
      <g fill="currentColor" stroke="none">
        <path d="M4.5 18v-4.4c0-3.8 1.9-6.3 4.9-7.2l.8 1.7c-1.8.9-2.7 2.2-2.9 3.7h2.6V18z" />
        <path d="M13.5 18v-4.4c0-3.8 1.9-6.3 4.9-7.2l.8 1.7c-1.8.9-2.7 2.2-2.9 3.7h2.6V18z" />
      </g>
    )}
  </svg>
</span>
