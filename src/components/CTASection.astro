---
import { withBase } from "../lib/url";
interface Props {
  headline?: string;
  body?: string;
  buttonText?: string;
}
const {
  headline = "Find Out Where You're Exposed — Before Someone Else Does",
  body = "Our Cybersecurity Audit gives you a clear, independent picture of the risks sitting in your network, servers, and endpoints. If you decide to move ahead with the recommended work, the full cost of your audit is credited straight back against the project.",
  buttonText = "Book Your Cybersecurity Audit",
} = Astro.props;
---
<section class="section section-accent cta-band" id="audit">
  <div class="container" style="text-align:center;">
    <h2 style="max-width:640px;margin:0 auto 12px;">{headline}</h2>
    {body && <p style="max-width:560px;margin:0 auto 24px;opacity:.95;">{body}</p>}
    <a class="btn" href={withBase("/contact#audit")} style="background:#fff;color:var(--color-accent-ink);">{buttonText}</a>
  </div>
</section>
