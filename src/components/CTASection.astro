---
import { withBase } from "../lib/url";
interface Props {
  headline?: string;
  body?: string;
  buttonText?: string;
  href?: string;
}
const {
  headline = "Find Out Where You're Exposed — Before Someone Else Does",
  body = "Our free Cybersecurity Review checks for staff passwords exposed online, how well your email and Microsoft 365 are protected, and what your systems show to the internet. Nothing is installed on your computers. You get a plain-English report with clear priorities, and there's no obligation.",
  buttonText = "Book Your Cybersecurity Review",
  href = "/contact#audit",
} = Astro.props;
const link = href.startsWith("/") ? withBase(href) : href;
---
<section class="section section-accent cta-band" id="audit">
  <div class="container cta-inner">
    <h2>{headline}</h2>
    {body && <p>{body}</p>}
    <a class="btn cta-btn" href={link}>{buttonText}</a>
  </div>
</section>

<style>
  .cta-band { padding: 40px 0; }
  .cta-inner { text-align: center; }
  .cta-inner h2 { color: #fff; font-size: clamp(28px, 3.4vw, 36px); max-width: 720px; margin: 0 auto 12px; }
  .cta-inner p { font-size: 18.5px; line-height: 1.55; max-width: 640px; margin: 0 auto 22px; opacity: .97; }
  .cta-btn { background: #fff; color: var(--color-accent-ink); font-size: 17px; padding: 16px 36px; }
  .cta-btn:hover { background: var(--color-bg-sunken); color: var(--color-accent-ink); }
</style>
