---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FormPopup from "../components/FormPopup.astro";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// Canonical always points at the live domain, so the GitHub Pages preview
// (noindex) never competes with netintellect.com.au in search results.
const preview = import.meta.env.BASE_URL !== "/";
const canonicalPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const canonical = new URL(canonicalPath, "https://netintellect.com.au").href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Net Intellect</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Net Intellect" />
    <meta property="og:title" content={`${title} · Net Intellect`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="48x48" />
    <link rel="icon" href={withBase("/favicon.png")} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <FormPopup />
  </body>
</html>
