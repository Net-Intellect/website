---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_FORM_URL, REVIEW_FORM_URL } from "../lib/offers";

// Both cards open the Microsoft Forms contact form (in the pop-up). Until that
// form exists, they fall back to a pre-addressed email.
const mail = (subject: string) => `mailto:info@netintellect.com.au?subject=${encodeURIComponent(subject)}`;
const enquiryHref = CONTACT_FORM_URL || mail("General enquiry");
const quoteHref = CONTACT_FORM_URL || mail("Quote request");
---
<BaseLayout
  title="Contact Us"
  description="Get in touch with Net Intellect for a general enquiry or to request a quote."
>
  <section class="section section-dark" style="text-align:center;">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="muted" style="max-width:560px;margin:0 auto;">
        Send us a general enquiry or request a quote, and the right person will get back to you.
        Want to know where you're exposed? <a href={REVIEW_FORM_URL} style="color:#fff;text-decoration:underline;">Book a free Cybersecurity Review</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div class="card" id="audit">
        <h2 style="font-size:17px;">General Enquiry</h2>
        <p class="muted" style="font-size:15.5px;">
          A question about our services, your IT, or how we could help? Send us a message and the
          right person will get back to you within one business day.
        </p>
        <a class="btn" href={enquiryHref}>Send an Enquiry</a>
      </div>

      <div class="card" id="quote">
        <h2 style="font-size:17px;">Request a Quote</h2>
        <p class="muted" style="font-size:15.5px;">
          Tell us what you need, whether it's SupportNet Managed IT, a new phone system, Microsoft 365 or a
          project, and we'll come back with a clear, fixed quote.
        </p>
        <a class="btn" href={quoteHref}>Request a Quote</a>
      </div>
    </div>

    <div class="container" style="margin-top:24px;">
      <div class="card">
        <h3 style="font-size:15.5px;">Albury Office</h3>
        <p class="muted" style="font-size:15.5px;">
          <a href="https://www.google.com/maps/search/?api=1&query=599+Nurigong+Street+South+Albury+NSW+2640" target="_blank" rel="noopener">599 Nurigong Street, South Albury NSW 2640</a><br>
          <a href="tel:+61260510999">(02) 6051 0999</a> · <a href="mailto:info@netintellect.com.au">info@netintellect.com.au</a>
        </p>
        <p style="font-size:14px;">
          <a href="https://netintellect.mspprocess.net/" target="_blank" rel="noopener">Remote Support →</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
