---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";

const testimonials = await getCollection("testimonials");
---
<BaseLayout
  title="Client Results"
  description="What Net Intellect clients across aged care, community health, NDIS and general business say about working with us."
>
  <section class="section section-dark" style="text-align:center;">
    <div class="container">
      <h1>Client Results</h1>
      <p class="muted" style="max-width:560px;margin:0 auto;">
        Many of our clients have been with us for over a decade. Here's what they say about working
        with Net Intellect, in their own words.
      </p>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container grid grid-2">
      {testimonials.map((t) => (
        <div class="card testimonial" id={t.id}>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
            <span class="tag" style={t.data.segment === "General Business" ? "background:#8a8f94;" : ""}>{t.data.segment}</span>
            {t.data.logo && <img src={withBase(t.data.logo)} alt={`${t.data.client} logo`} class="client-logo" />}
          </div>
          <div style="font-weight:700;font-size:16.5px;margin:10px 0 4px;">{t.data.client}</div>
          <div class="muted" style="font-size:13.5px;margin-bottom:10px;">{t.data.tenure}</div>
          <Icon name="quote" tile={false} />
          <p class="muted" style="font-size:15.5px;">{t.data.quote}</p>
          {t.data.attribution && <div style="font-size:14px;font-weight:700;margin-bottom:8px;">— {t.data.attribution}</div>}
          <div style="font-size:13.5px;font-weight:700;color:var(--color-accent-ink);">Outcome: {t.data.outcome}</div>
        </div>
      ))}
    </div>
  </section>

  <CTASection headline="Want results like these?" body="" />
</BaseLayout>

<style>
  .testimonial { scroll-margin-top: 96px; }
  .testimonial:target { border-color: var(--color-accent); box-shadow: 0 0 0 2px var(--color-accent); }
  .client-logo { max-height: 32px; max-width: 120px; width: auto; height: auto; object-fit: contain; }
</style>
