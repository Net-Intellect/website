---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";

const testimonials = await getCollection("testimonials");
---
<BaseLayout
  title="Client Results"
  description="Real outcomes from long-term Net Intellect partnerships across aged care, community health and general business."
>
  <section class="section section-dark" style="text-align:center;">
    <div class="container">
      <h1>Client Results</h1>
      <p class="muted" style="max-width:560px;margin:0 auto;">
        Real outcomes from long-term partnerships across aged care, community health and general
        business — elevated from scattered pull-quotes into full detail.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      {testimonials.map((t) => (
        <div class="card">
          <span class="tag" style={t.data.segment === "General Business" ? "background:#8a8f94;" : ""}>{t.data.segment}</span>
          <div style="font-weight:700;font-size:15px;margin:10px 0 4px;">{t.data.client}</div>
          <div class="muted" style="font-size:12.5px;margin-bottom:10px;">{t.data.tenure}</div>
          <p class="muted" style="font-size:14px;">{t.data.quote}</p>
          <div style="font-size:12.5px;font-weight:700;color:var(--color-accent-ink);">Outcome: {t.data.outcome}</div>
        </div>
      ))}
    </div>
  </section>

  <CTASection headline="Want results like these?" body="" />
</BaseLayout>
