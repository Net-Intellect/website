---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";

const industries = [
  { name: "Aged Care", icon: "aged-care", note: "24/7 operations where downtime affects resident care. We've supported Westmont Aged Care for over 10 years." },
  { name: "Community Health", icon: "community-health", note: "Multi-site organisations, outreach services and tight budgets that need predictable IT costs. AWAHS has been with us for over 15 years." },
  { name: "NDIS Providers", icon: "ndis", note: "Growing providers who need IT they can rely on without building an internal IT team, like Kindred Support." },
  { name: "Small & Medium Business", icon: "business", note: "From 5-computer offices to organisations with 100+ users, with right-sized support that grows with you." },
];
---
<BaseLayout
  title="Industries We Serve"
  description="Net Intellect has particular depth in aged care, community health and NDIS providers, alongside small and medium businesses across regional NSW/VIC."
>
  <section class="section page-intro">
    <div class="container">
      <h1>Industries We Serve</h1>
      <p class="muted lead">
        We support businesses of every kind across Albury-Wodonga, the Riverina and northeast
        Victoria, with particular depth in sectors where reliable IT directly affects the people you care for.
      </p>
    </div>
  </section>
  <section class="section section-sunken page-grid">
    <div class="container">
      <div class="grid grid-2">
        {industries.map((i) => (
          <div class="card">
            <Icon name={i.icon} />
            <h3 style="font-size:20px;">{i.name}</h3>
            <p class="muted" style="font-size:16px;margin:0;">{i.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>
