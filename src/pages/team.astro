---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import { withBase } from "../lib/url";

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Our Team"
  description="Meet the Net Intellect team — the people behind SupportNet Managed IT support across Albury-Wodonga and the Riverina."
>
  <section class="section section-dark">
    <div class="container">
      <span class="tag">Our Team</span>
      <h1 style="margin-top:14px;">Real People, Down the Road, Since 1996.</h1>
      <p class="muted" style="max-width:560px;">
        The people who answer your calls, look after your systems and know your business — based
        in Albury and supporting clients across Albury-Wodonga, the Riverina and northeast Victoria.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid team-grid">
      {team.map((m) => (
        <div class="card member">
          {m.data.photo ? (
            <img class="member-photo" src={withBase("/" + m.data.photo)} alt={m.data.name} />
          ) : (
            <div class="member-photo member-placeholder" aria-hidden="true">
              {/* A person on a monitor, until the real photo arrives. */}
              <svg viewBox="0 0 200 200" fill="none">
                <rect x="24" y="36" width="152" height="108" rx="9" fill="var(--color-charcoal)" />
                <rect x="33" y="45" width="134" height="90" rx="3" fill="#e6f5fb" />
                <circle cx="100" cy="76" r="17" fill="var(--color-accent)" />
                <path d="M68 135c0-22 14-34 32-34s32 12 32 34z" fill="var(--color-accent)" />
                <circle cx="41" cy="53" r="2.5" fill="var(--color-accent)" />
                <circle cx="49" cy="53" r="2.5" fill="var(--color-accent)" opacity=".5" />
                <path d="M88 144h24l4 20H84z" fill="var(--color-charcoal)" />
                <rect x="70" y="164" width="60" height="7" rx="3.5" fill="var(--color-charcoal)" />
              </svg>
            </div>
          )}
          <div style="font-weight:700;font-size:17px;margin-top:14px;">{m.data.name}</div>
          <div style="font-size:14px;font-weight:700;color:var(--color-accent-ink);margin-bottom:8px;">{m.data.role}</div>
          {m.data.bio && <p class="muted" style="font-size:15.5px;">{m.data.bio}</p>}
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .member-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 6px; display: block; }
  .member-placeholder { background: var(--color-bg-sunken); }
  .member-placeholder svg { width: 100%; height: 100%; display: block; }
  /* Ten people: two even rows of five on wide screens. */
  .team-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
