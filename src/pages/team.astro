---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import { withBase } from "../lib/url";

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
const initials = (name: string) =>
  name.replace(/[\[\]]/g, "").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join("");
---
<BaseLayout
  title="Our Team"
  description="Meet the Net Intellect team — the people behind managed IT support across Albury-Wodonga and the Riverina."
>
  <section class="section section-dark">
    <div class="container">
      <span class="tag">Our Team</span>
      <h1 style="margin-top:14px;">Real People, Down the Road, Since 1996.</h1>
      <p class="muted" style="max-width:560px;">
        The people who answer your calls, look after your systems and know your business — based
        in Albury and supporting clients across Albury-Wodonga, the Riverina and northeast Victoria.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3">
      {team.map((m) => (
        <div class="card member">
          {m.data.photo ? (
            <img class="member-photo" src={withBase("/" + m.data.photo)} alt={m.data.name} />
          ) : (
            <div class="member-photo member-initials" aria-hidden="true">{initials(m.data.name)}</div>
          )}
          <div style="font-weight:700;font-size:16px;margin-top:14px;">{m.data.name}</div>
          <div style="font-size:13px;font-weight:700;color:var(--color-accent-ink);margin-bottom:8px;">{m.data.role}</div>
          <p class="muted" style="font-size:14px;">{m.data.bio}</p>
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .member-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 6px; display: block; }
  .member-initials {
    display: flex; align-items: center; justify-content: center;
    background: var(--color-bg-sunken); color: var(--color-text-muted);
    font-size: 40px; font-weight: 700;
  }
</style>
