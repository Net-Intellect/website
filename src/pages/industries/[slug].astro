---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../lib/url";
import { REVIEW_FORM_URL } from "../../lib/offers";
import { visibleIndustries, type Industry } from "../../lib/industries";

export function getStaticPaths() {
  return visibleIndustries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props as { industry: Industry };
---
<BaseLayout title={`IT Support for ${industry.name}`} description={industry.summary}>
  {industry.draft && (
    <div class="draft-banner">Draft for review: on the preview only, not on netintellect.com.au.</div>
  )}
  <nav class="container" style="padding:14px 24px;font-size:13px;color:var(--color-text-muted);">
    <a href={withBase("/")}>Home</a> / <a href={withBase("/industries")}>Industries We Serve</a> /
    <strong style="color:var(--color-charcoal);">{industry.name}</strong>
  </nav>

  <section class="section section-dark">
    <div class="container">
      <span class="tag">{industry.name}</span>
      <h1 style="margin:14px 0;">{industry.headline}</h1>
      <p class="muted" style="max-width:600px;">{industry.summary}</p>
      <a class="btn" href={REVIEW_FORM_URL}>Book Your Cybersecurity Review</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="font-size:22px;">What We Hear From {industry.name.split(" ")[0]} Businesses</h2>
      <div class="grid grid-3">
        {industry.challenges.map((item) => (
          <div class="card"><p class="muted" style="margin:0;font-size:15.5px;">{item}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="font-size:22px;">How We Help</h2>
      <div class="grid grid-3">
        {industry.help.map((item) => (
          <div class="card">
            <h3 style="font-size:17px;margin:0 0 8px;">{item.title}</h3>
            <p class="muted" style="margin:0;font-size:15.5px;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <h2 style="font-size:22px;">From Our Clients</h2>
      {industry.proof ? (
        <div class="card">
          <div style="font-weight:700;font-size:14px;margin-bottom:8px;">{industry.proof.client}</div>
          <p style="margin:0 0 10px;font-size:17px;">“{industry.proof.quote}”</p>
          <p class="muted" style="margin:0 0 12px;font-size:14.5px;">— {industry.proof.attribution}</p>
          <a href={withBase(industry.proof.href)} style="font-weight:700;font-size:15px;">More client results →</a>
        </div>
      ) : (
        <div class="card placeholder"><p class="muted" style="margin:0;">{industry.proofPlaceholder}</p></div>
      )}
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="font-size:22px;">Services That Fit</h2>
      <div class="grid grid-3">
        <a class="card related" href={withBase("/services/managed-it-support")}><Icon name="managed-it-support" /><strong>SupportNet Managed IT</strong></a>
        <a class="card related" href={withBase("/services/supportnet-security")}><Icon name="supportnet-security" /><strong>SupportNet Security</strong></a>
        <a class="card related" href={withBase("/services/networking-mobile-computing")}><Icon name="networking-mobile-computing" /><strong>Networking & Mobile Computing</strong></a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .draft-banner {
    background: #fff4d6; color: #5a4300; border-bottom: 1px solid #e8d38f;
    text-align: center; font-size: 14px; font-weight: 700; padding: 8px 16px;
  }
  .placeholder { border-style: dashed; }
  .related { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--color-charcoal); }
  .related:hover strong { color: var(--color-accent-ink); }
</style>
