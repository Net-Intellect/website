---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../lib/url";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

// The tile name can differ from the service's own name. The SupportNet tiles lead:
// AI, Managed IT, then SupportNet Security, which has its own page rather than a
// collection entry.
const tileNames: Record<string, string> = {
  "ai-implementation-governance": "SupportNet AI",
  "managed-it-support": "SupportNet Managed IT",
};
const tiles = services.map((service) => ({
  id: service.id,
  name: tileNames[service.id] ?? service.data.name,
  summary: service.data.summary,
}));
tiles.splice(tiles.findIndex((t) => t.id === "managed-it-support") + 1, 0, {
  id: "supportnet-security",
  name: "SupportNet Security",
  summary: "A coordinated security platform plus governance and response, built to work alongside your internal IT team.",
});
tiles.unshift(...tiles.splice(tiles.findIndex((t) => t.id === "ai-implementation-governance"), 1));
---
<BaseLayout
  title="Services"
  description="Managed IT support, cybersecurity, cloud, AI implementation, networking, disaster recovery, voice and broadband services for regional NSW/VIC businesses."
>
  <section class="section page-intro">
    <div class="container">
      <h1>Services</h1>
      <p class="muted lead">
        From day-to-day support to cybersecurity, cloud and AI, everything your business needs
        from IT, delivered by one local team that knows your environment.
      </p>
    </div>
  </section>
  <section class="section section-sunken page-grid">
    <div class="container">
      <div class="grid grid-3">
        {tiles.map((tile) => (
          <a class="card" href={withBase(`/services/${tile.id}`)} style="text-decoration:none;">
            <Icon name={tile.id} />
            <h3 style="font-size:17px;">{tile.name}</h3>
            <p class="muted" style="font-size:15.5px;margin:0;">{tile.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>
