---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const ctaHref = data.cta ? (data.cta.href.startsWith("/") ? withBase(data.cta.href) : data.cta.href) : withBase("/contact#audit");
---
<BaseLayout title={data.name} description={data.summary}>
  <nav class="container" style="padding:14px 24px;font-size:13px;color:var(--color-text-muted);">
    <a href={withBase("/")}>Home</a> / <a href={withBase("/services")}>Services</a> /
    <strong style="color:var(--color-charcoal);">{data.name}</strong>
  </nav>

  <section class="section section-dark">
    <div class:list={["container", "hero-inner", { "no-image": !data.heroImage }]}>
      <div>
        <span class="tag">Service</span>
        <h1 style="margin:14px 0;">{data.name}</h1>
        <p class="muted" style="max-width:560px;">{data.summary}</p>
        <a class="btn" href={ctaHref}>{data.cta?.label ?? "Book Your Cybersecurity Review"}</a>
      </div>
      {data.heroImage && <img src={withBase(data.heroImage)} alt="" />}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="font-size:22px;">Who This Is For</h2>
      <div class="grid grid-3">
        {data.whoFor.map((item) => (
          <div class="card"><p class="muted" style="margin:0;font-size:15.5px;">{item}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="font-size:22px;">Outcomes</h2>
      <div class="grid grid-3">
        {data.outcomes.map((item) => (
          <div class="card"><p style="margin:0;font-weight:700;font-size:15.5px;">{item}</p></div>
        ))}
      </div>
    </div>
  </section>

  {data.offerings && data.offerings.map((group, i) => (
    <section class:list={["section", { "section-sunken": i % 2 === 1 }]}>
      <div class="container">
        <h2 style="font-size:22px;">{group.group}</h2>
        {group.intro && <p class="muted" style="max-width:640px;margin-top:0;">{group.intro}</p>}
        <div class:list={["grid", group.items.length % 3 === 0 || group.items.length > 4 ? "grid-3" : "grid-2"]} style="margin-top:16px;">
          {group.items.map((item) => (
            <div class="card offering">
              {item.platform && <span class="offering-platform">{item.platform}</span>}
              <h3 style="font-size:17px;margin:6px 0 8px;">{item.name}</h3>
              <p class="muted" style="font-size:15.5px;margin:0 0 10px;">{item.summary}</p>
              {item.features && (
                <ul class="offering-features">
                  {item.features.map((f) => <li>{f}</li>)}
                </ul>
              )}
              {item.bestFor && <p class="offering-bestfor"><strong>Best for:</strong> {item.bestFor}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <h2 style="font-size:22px;">What's Included</h2>
        <div class="card">
          <ul style="margin:0;padding-left:18px;font-size:15.5px;color:var(--color-text-muted);">
            {data.included.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div>
        <h2 style="font-size:22px;">Proof Point</h2>
        <div class="card">
          {data.proofPointClient && <div style="font-weight:700;font-size:14px;margin-bottom:8px;">{data.proofPointClient}</div>}
          <p class="muted" style="margin:0;font-size:15.5px;">{data.proofPointQuote}</p>
        </div>
      </div>
    </div>
    <div class="container" style="margin-top:24px;max-width:66ch;">
      <Content />
    </div>
  </section>

  {data.relatedPage && (
    <section class="section section-sunken">
      <div class="container">
        <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;">
          <div style="max-width:60ch;">
            <div style="font-weight:700;font-size:16.5px;margin-bottom:6px;">{data.relatedPage.title}</div>
            <p class="muted" style="margin:0;font-size:15.5px;">{data.relatedPage.blurb}</p>
          </div>
          <a class="btn" href={withBase(data.relatedPage.href)} style="white-space:nowrap;">
            See the {data.relatedPage.title} stack →
          </a>
        </div>
      </div>
    </section>
  )}

  {data.cta
    ? <CTASection headline={data.cta.headline} body={data.cta.body} buttonText={data.cta.label} href={data.cta.href} />
    : <CTASection />}
</BaseLayout>

<style>
  .offering { display: flex; flex-direction: column; }
  .offering-platform {
    align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: var(--color-accent-ink);
    background: var(--color-bg-sunken); border: 1px solid var(--color-border);
    padding: 3px 8px; border-radius: 3px;
  }
  .section-sunken .offering-platform { background: var(--color-bg); }
  .offering-features { margin: 0 0 10px; padding-left: 18px; font-size: 13.5px; color: var(--color-text-muted); }
  .offering-features li { margin-bottom: 3px; }
  .offering-bestfor { margin: auto 0 0; padding-top: 10px; border-top: 1px solid var(--color-border); font-size: 13px; }
</style>
