---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const testimonials = await getCollection("testimonials");
const featured = ["Westmont Aged Care", "AWAHS", "SJE Consulting"];
const featuredTestimonials = testimonials.filter((t) => featured.includes(t.data.client));
---
<BaseLayout
  title="Managed IT Support — Albury-Wodonga & the Riverina"
  description="Managed IT support, Microsoft 365/Azure, cybersecurity and AI governance for aged care, community health and growing businesses across Albury-Wodonga and the Riverina."
>
  <section class="section section-dark hero">
    <div class="container hero-inner">
      <div>
        <span class="tag">Managed IT · Albury-Wodonga &amp; the Riverina</span>
        <h1 style="font-size:clamp(28px,4vw,40px);margin-top:16px;">
          Managed IT Support Trusted by Aged Care, Community Health &amp; Growing Businesses
        </h1>
        <p class="muted" style="max-width:520px;font-size:17px;">
          Responsive IT support, Microsoft 365/Azure, cybersecurity and AI governance — backed by
          10 to 15+ year client relationships across regional NSW/VIC.
        </p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <a class="btn" href={withBase("/contact#audit")}>Book Your Cybersecurity Audit</a>
          <a class="btn btn-outline" href={withBase("/contact")}>Get in Touch</a>
        </div>
      </div>
      <img src={withBase("/images/hero/it-support.jpg")} alt="" />
    </div>
  </section>

  <section style="background:var(--color-bg-sunken);padding:14px 0;">
    <div class="container client-strip">
      <a href={withBase("/client-results#westmont-aged-care")}>WESTMONT AGED CARE · 10+ YRS</a>
      <a href={withBase("/client-results#awahs")}>AWAHS · 15+ YRS</a>
      <a href={withBase("/client-results#sje-consulting")}>SJE CONSULTING · 10+ YRS</a>
      <a href={withBase("/client-results#kindred-support")}>KINDRED SUPPORT · NDIS</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="tag">Local since 1996</span>
      <h2 style="font-size:clamp(24px,3.2vw,32px);margin-top:14px;">30 Years Local. Still Local.</h2>
      <p class="muted" style="max-width:640px;font-size:17px;">
        Net Intellect has been looking after businesses from our Albury office since 1996. When
        something goes wrong, you're dealing with people who know your systems, know your site and
        can be there in person — not a ticket queue in another state.
      </p>
      <div class="grid grid-3" style="margin-top:24px;">
        <div class="card">
          <h3 style="font-size:16.5px;">One office, right here</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Based in Albury and on the road across Albury-Wodonga, the Riverina and northeast
            Victoria. On-site when you need us, not just on the phone.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size:16.5px;">Relationships measured in decades</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Clients like AWAHS (15+ years), Westmont Aged Care and SJE Consulting (10+ years each)
            have stayed because the people who know their environment are still here.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size:16.5px;">Local hands, enterprise-grade tools</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Microsoft 365, Azure, cybersecurity and AI governance, delivered by a team you can meet
            face to face.
          </p>
        </div>
      </div>
      <p style="margin:20px 0 0;">
        <a href={withBase("/about")}>Our story →</a>
      </p>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="text-align:center;">Services</h2>
      <p class="muted" style="text-align:center;max-width:520px;margin:0 auto 28px;">
        Everything your business needs from IT, delivered and supported by one local team.
      </p>
      <div class="grid grid-4">
        {services.map((service) => (
          <a class="card" href={withBase(`/services/${service.id}`)} style="text-decoration:none;">
            <Icon name={service.id} />
            <h3 style="font-size:16.5px;">{service.data.name}</h3>
            <p class="muted" style="font-size:15px;margin:0;">{service.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">Client Results</h2>
      <div class="grid grid-3" style="margin-top:20px;">
        {featuredTestimonials.map((t) => (
          <div class="card">
            {t.data.logo && <img src={withBase(t.data.logo)} alt={`${t.data.client} logo`} style="max-height:28px;max-width:110px;width:auto;height:auto;object-fit:contain;margin-bottom:10px;" />}
            <div style="font-weight:700;font-size:14px;margin-bottom:8px;">{t.data.client} · {t.data.tenure}</div>
            <Icon name="quote" tile={false} />
            <p class="muted" style="font-size:15px;margin:0;">{t.data.quote}</p>
          </div>
        ))}
      </div>
      <p style="text-align:center;margin-top:20px;">
        <a href={withBase("/client-results")}>See all client results →</a>
      </p>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .client-strip {
    display: flex; gap: 28px; justify-content: center; flex-wrap: wrap;
    font-size: 12px; font-weight: 700;
  }
  .client-strip a { color: var(--color-text-muted); text-decoration: none; }
  .client-strip a:hover, .client-strip a:focus-visible { color: var(--color-accent-ink); text-decoration: underline; }
</style>
