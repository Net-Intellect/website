---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/url";

// Homepage features four core services (Ashley's review, item 7); the rest live on /services.
const featuredServiceIds = [
  "managed-it-support",
  "cybersecurity-compliance",
  "microsoft-365-cloud-azure",
  "ai-implementation-governance",
];
const services = (await getCollection("services"))
  .filter((s) => featuredServiceIds.includes(s.id))
  .sort((a, b) => a.data.order - b.data.order);
const testimonials = await getCollection("testimonials");
const featured = ["AWAHS", "SJE Consulting", "The Man From Snowy River Bush Festival"];
const featuredTestimonials = testimonials.filter((t) => featured.includes(t.data.client));
---
<BaseLayout
  title="Managed IT Support — Albury-Wodonga & the Riverina"
  description="Managed IT support, Microsoft 365/Azure, cybersecurity and AI governance for aged care, community health and growing businesses across Albury-Wodonga and the Riverina."
>
  <section class="section section-dark hero">
    <div class="container hero-inner">
      <div>
        <span class="tag">Managed IT · Albury-Wodonga &amp; the Riverina</span>
        <h1 style="font-size:clamp(28px,4vw,40px);margin-top:16px;">
          Managed IT Support Trusted by Aged Care, Community Health &amp; Growing Businesses
        </h1>
        <p class="muted" style="max-width:520px;font-size:17px;">
          Responsive IT support, Microsoft 365/Azure, cybersecurity and AI governance — backed by
          10 to 15+ year client relationships across regional NSW/VIC.
        </p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <a class="btn" href={withBase("/contact#audit")}>Book Your Cybersecurity Audit</a>
          <a class="btn btn-outline" href={withBase("/contact")}>Talk to Our Team</a>
        </div>
      </div>
      <img src={withBase("/images/hero/it-support.jpg")} alt="" />
    </div>
  </section>

  <section style="background:var(--color-bg-sunken);padding:14px 0;">
    <div class="container client-strip">
      <a href={withBase("/client-results#awahs")}>AWAHS · 15+ YRS</a>
      <a href={withBase("/client-results#sje-consulting")}>SJE CONSULTING · 10+ YRS</a>
      <a href={withBase("/client-results#man-from-snowy-river-bush-festival")}>MAN FROM SNOWY RIVER BUSH FESTIVAL</a>
      <a href={withBase("/client-results#kindred-support")}>KINDRED SUPPORT · NDIS</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="tag">Local since 1996</span>
      <h2 style="font-size:clamp(24px,3.2vw,32px);margin-top:14px;">30 Years Local. Still Local.</h2>
      <p class="muted" style="max-width:640px;font-size:17px;">
        Net Intellect has been looking after businesses from our Albury office since 1996. When
        something goes wrong, you're dealing with people who know your systems, know your site and
        can be there in person — not a ticket queue in another state.
      </p>
      <div class="grid grid-3" style="margin-top:24px;">
        <div class="card">
          <h3 style="font-size:16.5px;">One office, right here</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Based in Albury and on the road across Albury-Wodonga, the Riverina and northeast
            Victoria. On-site when you need us, not just on the phone.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size:16.5px;">Relationships measured in decades</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Clients like AWAHS (15+ years) and SJE Consulting (10+ years) have stayed because the people who know their environment are still here.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size:16.5px;">Local hands, enterprise-grade tools</h3>
          <p class="muted" style="font-size:15.5px;margin:0;">
            Microsoft 365, Azure, cybersecurity and AI governance, delivered by a team you can meet
            face to face.
          </p>
        </div>
      </div>
      <p style="margin:20px 0 0;">
        <a href={withBase("/about")}>Our story →</a>
      </p>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="text-align:center;">Everything your business needs from IT.</h2>
      <p class="muted" style="text-align:center;max-width:560px;margin:0 auto 28px;font-size:18px;">
        Practical technology support from one local team.
      </p>
      <div class="grid grid-2 featured-services">
        {services.map((service) => (
          <a class="card featured-service" href={withBase(`/services/${service.id}`)}>
            <Icon name={service.id} />
            <h3>{service.data.name}</h3>
            <p class="muted">{service.data.summary}</p>
            <span class="learn-more">Learn more <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p style="text-align:center;margin:28px 0 0;">
        <a class="btn" href={withBase("/services")}>View All Services</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">Client Results</h2>
      <div class="grid grid-3" style="margin-top:20px;">
        {featuredTestimonials.map((t) => (
          <div class="card home-testimonial">
            {t.data.logo && <span class="home-logo"><img src={withBase(t.data.logo)} alt={`${t.data.client} logo`} /></span>}
            <div style="font-weight:700;font-size:14px;margin-bottom:8px;">{t.data.client} · {t.data.tenure}</div>
            <Icon name="quote" tile={false} />
            <p class="muted home-quote">{t.data.quote}</p>
            <a class="home-read" href={withBase(`/client-results#${t.id}`)}>Read full story <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </div>
      <p style="text-align:center;margin-top:20px;">
        <a href={withBase("/client-results")}>See all client results →</a>
      </p>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .client-strip {
    display: flex; gap: 28px; justify-content: center; flex-wrap: wrap;
    font-size: 14.5px; font-weight: 700; /* about 11pt */
  }
  .client-strip a { color: var(--color-text-muted); text-decoration: none; }
  .client-strip a:hover, .client-strip a:focus-visible { color: var(--color-accent-ink); text-decoration: underline; }
  .featured-services { max-width: 960px; margin: 0 auto; }
  .featured-service { display: flex; flex-direction: column; padding: 28px; text-decoration: none; }
  .featured-service h3 { font-size: 20px; margin-bottom: 8px; }
  .featured-service p { font-size: 16px; margin: 0 0 14px; }
  .featured-service .learn-more { margin-top: auto; font-weight: 700; font-size: 15.5px; color: var(--color-accent); }
  .featured-service:hover .learn-more { color: var(--color-accent-ink); }
  .home-quote { font-size: 15.5px; margin: 0 0 12px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; line-clamp: 4; overflow: hidden; }
  .home-read { font-weight: 700; font-size: 15px; margin-top: auto; }
  .home-testimonial { display: flex; flex-direction: column; }
  .home-logo { height: 40px; display: flex; align-items: center; margin-bottom: 10px; }
  .home-logo img { max-height: 40px; max-width: 140px; width: auto; height: auto; object-fit: contain; }
</style>
