---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---
<BaseLayout title="Page Not Found" description="The page you were looking for isn't here.">
  <section class="section section-dark" style="text-align:center;">
    <div class="container">
      <h1>We Couldn't Find That Page</h1>
      <p class="muted" style="max-width:560px;margin:0 auto 24px;">
        Our website has been rebuilt, so some older pages have moved or been retired.
        Try one of these instead, or give us a call on <a href="tel:+61260510999" style="color:#fff;">(02) 6051 0999</a>.
      </p>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a class="btn" href={withBase("/")}>Home</a>
        <a class="btn btn-outline" href={withBase("/services")}>Our Services</a>
        <a class="btn btn-outline" href={withBase("/contact")}>Contact Us</a>
      </p>
    </div>
  </section>
</BaseLayout>
