---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";

const partners = ["Microsoft", "Dell", "ThreatLocker", "Kaseya", "Proofpoint", "Inforcer", "CyberSecure", "WatchGuard"];
---
<BaseLayout
  title="About"
  description="Net Intellect is a Managed Service Provider based in Albury-Wodonga, serving NSW/VIC since 1996."
>
  <section class="section section-dark">
    <div class="container">
      <span class="tag">About Net Intellect</span>
      <h1 style="margin-top:14px;">Three Decades in Albury-Wodonga &amp; the Riverina</h1>
      <p class="muted" style="max-width:560px;">
        A Managed Service Provider based in Albury, NSW, serving Albury-Wodonga, the Riverina and
        northeast Victoria — including Shepparton, Wangaratta, Wagga, Rutherglen and Leeton — since 1996.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3">
      <div class="card">
        <Icon name="history" />
        <h3 style="font-size:16.5px;">Company History</h3>
        <p class="muted" style="font-size:15.5px;">
          Founded in Albury in 1996, and still here 30 years on — same region, one office, with
          client relationships now running 10 to 15+ years. [Fuller history narrative to be
          confirmed with Andre.]
        </p>
      </div>
      <div class="card">
        <Icon name="values" />
        <h3 style="font-size:16.5px;">Vision &amp; Values</h3>
        <p class="muted" style="font-size:15.5px;">
          [Vision/values statement to be confirmed with Andre.]
        </p>
      </div>
      <div class="card">
        <Icon name="people" />
        <h3 style="font-size:16.5px;">Who We Serve</h3>
        <p class="muted" style="font-size:15.5px;">
          From 5-computer businesses to 100+ computer organisations, with particular depth in
          aged care and community health.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <h2 style="text-align:center;font-size:22px;">Our Partners</h2>
      <div class="grid grid-4" style="margin-top:20px;">
        {partners.map((p) => (
          <div class="card" style="text-align:center;font-weight:700;font-size:14px;color:var(--color-text-muted);">{p}</div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
